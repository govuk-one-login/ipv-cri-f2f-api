{
  "name": "test-harness",
  "version": "1.0.0",
  "description": "Harness to enable automation testing",
  "main": "index.js",
  "scripts": {
    "ui:dev": "node yotiCallbackTestUI/dev.mjs",
    "compile": "./node_modules/.bin/tsc",
    "unit": "vitest run tests/unit",
    "test:unit": "npm run compile && npm run unit",
    "lint": "eslint -c eslint.config.mjs *.ts .",
    "lint:fix": "eslint --fix --output-file ./reports/eslint/report.html --format html -c eslint.config.mjs --ext *.ts ."
  },
  "author": "GDS",
  "license": "MIT",
  "dependencies": {
    "@govuk-one-login/cri-logger": "1.1.0",
    "@aws-sdk/client-dynamodb": "3.1045.0",
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/client-sfn": "3.1045.0",
    "@aws-sdk/credential-providers": "3.1045.0",
    "@aws-sdk/lib-dynamodb": "3.1045.0",
    "@codegenie/serverless-express": "5.0.0",
    "@smithy/node-http-handler": "4.0.4",
    "esbuild": "0.28.1",
    "express": "4.22.3",
    "express-asyncify": "2.1.2",
    "govuk-frontend": "6.6.0",
    "nunjucks": "3.2.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.148",
    "@types/express": "4.17.21",
    "@types/node": "20.14.8",
    "@types/nunjucks": "3.2.6",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.7.0",
    "typescript": "4.9.4",
    "vitest": "4.1.12",
    "vitest-mock-extended": "3.1.0"
  },
  "engines": {
    "node": "24.*"
  },
  "type": "module"
}
